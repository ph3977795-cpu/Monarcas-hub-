function toggleFly(enable)
    Modules.Fly.Enabled = enable
    if enable then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "Lunar_FlyBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.P = 1250
        bv.Parent = hrp
        Modules.Fly.BV = bv
        local bob = 0
        if Modules.Fly.Conn then Modules.Fly.Conn:Disconnect() end
        Modules.Fly.Conn = RunService.RenderStepped:Connect(function(dt)
            if not Modules.Fly.Enabled or not hrp or not hrp.Parent then return end
            local cam = workspace.CurrentCamera
            local md = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then md += cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then md -= cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then md -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then md += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then md += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then md -= Vector3.new(0, 1, 0) end
            bob += dt * 1.5
            if md.Magnitude > 0 then
                bv.Velocity = md.Unit * Modules.Fly.Speed
            else
                bv.Velocity = Vector3.new(0, math.sin(bob) * 0.3, 0)
            end
        end)
    else
        if Modules.Fly.Conn then Modules.Fly.Conn:Disconnect() Modules.Fly.Conn = nil end
        if Modules.Fly.BV then Modules.Fly.BV:Destroy() Modules.Fly.BV = nil end
        if State.humanoid then State.humanoid.PlatformStand = false end
    end
end

