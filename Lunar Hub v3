function getClosestTarget()
    local mRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not mRoot then return nil end
    local closest, sd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                local dist = (mRoot.Position - root.Position).Magnitude
                if dist < sd and dist < 500 then
                    local cam = workspace.CurrentCamera
                    local tT = (root.Position - cam.CFrame.Position)
                    local dot = cam.CFrame.LookVector:Dot(tT.Unit)
                    if dot > 0 then
                        local ang = math.deg(math.acos(math.clamp(dot, -1, 1)))
                        if ang < Modules.Aimbot.FOV then sd = dist; closest = root end
                    end
                end
            end
        end
    end
    return closest
end

