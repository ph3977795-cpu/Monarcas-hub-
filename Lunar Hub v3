local STORAGE_FILE = "lunar_cfg.dat"
local DAYS_VALID = 7
local MAX_ATTEMPTS = 5

local function hasFileAPI()
    return writefile ~= nil and readfile ~= nil and isfile ~= nil
end

local function xorStr(s, k)
    local o = {}
    for i = 1, #s do o[i] = string.char(bit32.bxor(string.byte(s, i), k)) end
    return table.concat(o)
end

local function saveKeyData()
    if not hasFileAPI() then return end
    local expiresAt = os.time() + (DAYS_VALID * 86400)
    local raw = "EXP:" .. tostring(expiresAt)
    pcall(function() writefile(STORAGE_FILE, xorStr(raw, 42)) end)
end

local function loadKeyData()
    if not hasFileAPI() then return nil end
    local ok, data = pcall(function()
        if isfile(STORAGE_FILE) then return xorStr(readfile(STORAGE_FILE), 42) end
    end)
    if not ok or not data then return nil end
    return tonumber(data:match("EXP:(%d+)"))
end

local function isKeyValid()
    local exp = loadKeyData()
    if not exp then return false, 0 end
    if os.time() >= exp then return false, 0 end
    return true, math.floor((exp - os.time()) / 86400)
end

