local ESP_Config = {
    Enabled = false, ShowBox = true, ShowLines = true, ShowNames = true,
    Color = Palette.Purple, BoxThickness = 1.5, LineThickness = 1,
    TextSize = 14, MaxDistance = 500,
}
local ESPObjects = {}
local ESP_RenderConn = nil

local function espIsFinite(n) return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge end
local function espValidVec2(v) return v and espIsFinite(v.X) and espIsFinite(v.Y) end
local function espNewDrawing(c)
    local ok, o = pcall(function() return Drawing.new(c) end)
    return ok and o or nil
end

local function espCreateBox(p)
    if ESPObjects[p.UserId] and ESPObjects[p.UserId].Box then
        for _, l in ipairs(ESPObjects[p.UserId].Box) do pcall(function() l:Remove() end) end
    end
    local box = {}
    for i = 1, 4 do
        local line = espNewDrawing("Line")
        if line then
            line.Color = ESP_Config.Color
            line.Thickness = ESP_Config.BoxThickness
            line.Transparency = 1
            line.Visible = false
            line.ZIndex = 2
            table.insert(box, line)
        end
    end
    ESPObjects[p.UserId] = ESPObjects[p.UserId] or {}
    ESPObjects[p.UserId].Box = box
end

local function espCreateLine(p)
    if ESPObjects[p.UserId] and ESPObjects[p.UserId].Line then return end
    local line = espNewDrawing("Line")
    if line then
        line.Color = ESP_Config.Color
        line.Thickness = ESP_Config.LineThickness
        line.Transparency = 1
        line.Visible = false
        line.ZIndex = 1
        ESPObjects[p.UserId] = ESPObjects[p.UserId] or {}
        ESPObjects[p.UserId].Line = line
    end
end

local function espCreateName(p)
    if ESPObjects[p.UserId] and ESPObjects[p.UserId].Name then return end
    local txt = espNewDrawing("Text")
    if txt then
        txt.Color = ESP_Config.Color
        txt.Size = ESP_Config.TextSize
        txt.Center = true
        txt.Outline = true
        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
        txt.Font = 2
        txt.Text = p.Name
        txt.Visible = false
        txt.ZIndex = 3
        ESPObjects[p.UserId] = ESPObjects[p.UserId] or {}
        ESPObjects[p.UserId].Name = txt
    end
end

local function espHide(p)
    local d = ESPObjects[p.UserId]
    if not d then return end
    if d.Box then for _, l in ipairs(d.Box) do pcall(function() l.Visible = false end) end end
    if d.Line then pcall(function() d.Line.Visible = false end) end
    if d.Name then pcall(function() d.Name.Visible = false end) end
end

local function espRemove(p)
    local d = ESPObjects[p.UserId]
    if not d then return end
    if d.Box then for _, l in ipairs(d.Box) do pcall(function() l:Remove() end) end end
    if d.Line then pcall(function() d.Line:Remove() end) end
    if d.Name then pcall(function() d.Name:Remove() end) end
    ESPObjects[p.UserId] = nil
end

local function espGetBounds(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return nil end
    local top = head and (head.Position + Vector3.new(0, head.Size.Y/2 + 0.5, 0)) or (hrp.Position + Vector3.new(0, 3, 0))
    local bot = hrp.Position - Vector3.new(0, 3, 0)
    local ts = Camera:WorldToScreenPoint(top)
    local bs = Camera:WorldToScreenPoint(bot)
    if ts.Z <= 0 or bs.Z <= 0 then return nil end
    if not espIsFinite(ts.X) or not espIsFinite(ts.Y) then return nil end
    if not espIsFinite(bs.X) or not espIsFinite(bs.Y) then return nil end
    local h = math.abs(ts.Y - bs.Y)
    if not espIsFinite(h) or h < 5 or h > 2000 then return nil end
    return Vector2.new((ts.X + bs.X)/2, bs.Y), h/2, h
end

local function espUpdate()
    if not ESP_Config.Enabled then return end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local camCF = Camera.CFrame
    local camLook = camCF.LookVector
    local camPos = camCF.Position
    local vp = Camera.ViewportSize
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then
            if ESPObjects[p.UserId] then espRemove(p) end
            continue
        end
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then
            if ESPObjects[p.UserId] then espRemove(p) end
            continue
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then espHide(p) continue end
        local toT = hrp.Position - camPos
        if toT.Magnitude < 0.1 then espHide(p) continue end
        if camLook:Dot(toT.Unit) <= 0 then espHide(p) continue end
        if myHrp and (myHrp.Position - hrp.Position).Magnitude > ESP_Config.MaxDistance then
            espHide(p)
            continue
        end
        if not ESPObjects[p.UserId] then
            if ESP_Config.ShowBox then espCreateBox(p) end
            if ESP_Config.ShowLines then espCreateLine(p) end
            if ESP_Config.ShowNames then espCreateName(p) end
        else
            local d = ESPObjects[p.UserId]
            if ESP_Config.ShowBox and not d.Box then espCreateBox(p) end
            if ESP_Config.ShowLines and not d.Line then espCreateLine(p) end
            if ESP_Config.ShowNames and not d.Name then espCreateName(p) end
        end
        local sp, w, h = espGetBounds(char)
        if sp then
            local on = sp.X > -200 and sp.X < vp.X + 200 and sp.Y > -200 and sp.Y < vp.Y + 200
            if on then
                local d = ESPObjects[p.UserId]
                if d and d.Box and #d.Box >= 4 then
                    local tl = Vector2.new(sp.X - w/2, sp.Y - h)
                    local tr = Vector2.new(sp.X + w/2, sp.Y - h)
                    local bl = Vector2.new(sp.X - w/2, sp.Y)
                    local br = Vector2.new(sp.X + w/2, sp.Y)
                    d.Box[1].From = tl; d.Box[1].To = tr; d.Box[1].Visible = ESP_Config.ShowBox
                    d.Box[2].From = bl; d.Box[2].To = br; d.Box[2].Visible = ESP_Config.ShowBox
                    d.Box[3].From = tl; d.Box[3].To = bl; d.Box[3].Visible = ESP_Config.ShowBox
                    d.Box[4].From = tr; d.Box[4].To = br; d.Box[4].Visible = ESP_Config.ShowBox
                end
                if d and d.Line then
                    d.Line.From = Vector2.new(vp.X/2, vp.Y)
                    d.Line.To = 
