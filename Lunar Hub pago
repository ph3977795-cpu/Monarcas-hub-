local KEY_B64 = "TFVOQVItNzc3"
local DAYS_VALID = 7
local MAX_ATTEMPTS = 5
local STORAGE_FILE = "lunar_cfg.dat"

local function b64Decode(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    data = data:gsub('[^'..b..'=]', '')
    return (data:gsub('.', function(x)
        if x == '=' then return '' end
        local r, f = '', (b:find(x, 1, true) - 1)
        for i = 6, 1, -1 do
            r = r .. (f % 2^i - f % 2^(i-1) > 0 and '1' or '0')
        end
        return r
    end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
        if #x ~= 8 then return '' end
        local c = 0
        for i = 1, 8 do c = c + (x:sub(i,i) == '1' and 2^(8-i) or 0) end
        return string.char(c)
    end))
end

local function reconstructKey() return b64Decode(KEY_B64) end

local function hashKey(str)
    local h = 5381
    for i = 1, #str do h = ((h * 33) + string.byte(str, i)) % 4294967296 end
    return h
end

local KEY_HASH = hashKey(reconstructKey())

local function xorStr(s, k)
    local o = {}
    for i = 1, #s do o[i] = string.char(bit32.bxor(string.byte(s, i), k)) end
    return table.concat(o)
end

local function saveKeyData()
    if not (writefile and readfile) then return end
    local exp = os.time() + (DAYS_VALID * 86400)
    pcall(function() writefile(STORAGE_FILE, xorStr("EXP:" .. exp, 42)) end)
end

local function loadKeyData()
    if not (readfile and isfile) then return nil end
    local ok, d = pcall(function()
        if isfile(STORAGE_FILE) then return xorStr(readfile(STORAGE_FILE), 42) end
    end)
    if not ok or not d then return nil end
    return tonumber(d:match("EXP:(%d+)"))
end

local function isKeyValid()
    local exp = loadKeyData()
    if not exp then return false, 0 end
    if os.time() >= exp then return false, 0 end
    return true, math.floor((exp - os.time()) / 86400)
end

